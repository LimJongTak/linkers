# ──────────────────────────────────────────────────────────────
#  링커스 환경변수 템플릿
#  이 파일을 복사해 .env.local 로 사용하세요: cp .env.example .env.local
#  실제 값으로 채운 .env.local 은 절대 커밋하지 마세요!
# ──────────────────────────────────────────────────────────────

# ── DB ────────────────────────────────────────────────────────
# 로컬: docker-compose up 후 아래 값 그대로 사용
# 프로덕션: Vercel 환경변수에 RDS 연결 문자열 설정
DATABASE_URL="postgresql://linkers:linkers@localhost:5432/linkers_dev"

# ── JWT (최소 64자 랜덤 문자열 권장) ──────────────────────────
# 생성: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-min-64-chars"
JWT_REFRESH_SECRET="change-me-min-64-chars-refresh"

# ── 카카오 OAuth ───────────────────────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:3000/api/auth/kakao/callback"

# ── 포트원 v2 ─────────────────────────────────────────────────
# https://admin.portone.io → 상점 → API Keys
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_KAKAO_KEY=""
NEXT_PUBLIC_PORTONE_CARD_KEY=""

# ── AWS ───────────────────────────────────────────────────────
# IAM 사용자 권한: s3:GetObject, s3:PutObject, s3:DeleteObject
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="linkers-files-dev"

# ── 카카오 알림톡 (NHN Cloud) ─────────────────────────────────
KAKAO_ALIMTALK_APP_KEY=""
KAKAO_ALIMTALK_SECRET=""
KAKAO_SENDER_KEY=""
SMS_SENDER_NO=""

# ── 앱 설정 ───────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE="http://localhost:3000"
ALLOWED_ORIGIN="http://localhost:3000"

# ── Vercel Cron 인증 ──────────────────────────────────────────
CRON_SECRET="change-me"
