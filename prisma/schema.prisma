generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  nickname       String
  role           UserRole  @default(buyer)
  oauth_provider String
  oauth_id       String
  password_hash  String?
  profile_image  String?
  bio            String?  @db.Text
  phone          String?
  push_token     String?
  points         Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  programs           Program[]
  deposit_requests   DepositRequest[]
  orders             Order[]
  reviews            Review[]
  permissions        DownloadPermission[]
  settlements        Settlement[]
  point_transactions PointTransaction[]
  withdrawals        Withdrawal[]
  notices            Notice[]
  wishlists          Wishlist[]
  coupons_created    Coupon[]      @relation("CouponCreator")
  coupon_usages      CouponUsage[]
  user_coupons       UserCoupon[]
  cart_items         CartItem[]
  inquiries          Inquiry[]
  inquiry_replies    InquiryReply[]
  notifications      Notification[]
  reports_submitted  Report[]       @relation("ReportReporter")
  reports_reviewed   Report[]       @relation("ReportReviewer")
  chat_rooms_as_user   ChatRoom[]    @relation("ChatRoomUser")
  chat_rooms_as_seller ChatRoom[]    @relation("ChatRoomSeller")
  sent_messages        ChatMessage[] @relation("ChatMessageSender")

  @@unique([oauth_provider, oauth_id])
  @@map("users")
}

model Program {
  id               String        @id @default(uuid())
  seller_id        String
  product_type     ProductType   @default(file_product)
  title            String
  subtitle         String?
  category         String
  target_levels    String[]
  region           String[]
  price            Int
  sale_price       Int?
  sale_start_at    DateTime?
  sale_end_at      DateTime?
  description      String        @db.Text
  thumbnail_url    String?
  preview_url      String?
  status           ProgramStatus @default(draft)
  file_format      String?
  page_count       Int?
  max_participants Int?
  duration         String?
  tags             String[]
  rating_avg       Decimal       @default(0) @db.Decimal(3, 2)
  review_count     Int           @default(0)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  seller     User          @relation(fields: [seller_id], references: [id])
  files      ProgramFile[]
  orders     Order[]
  reviews    Review[]
  wishlists  Wishlist[]
  coupons    Coupon[]
  cart_items CartItem[]
  inquiries  Inquiry[]
  reports    Report[]

  @@map("programs")
}

model ProgramFile {
  id         String   @id @default(uuid())
  program_id String
  file_name  String
  s3_key     String
  file_size  BigInt
  file_type  String
  is_preview Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  program     Program              @relation(fields: [program_id], references: [id], onDelete: Cascade)
  permissions DownloadPermission[]

  @@map("program_files")
}

model Order {
  id             String      @id @default(uuid())
  order_number   String      @unique
  buyer_id       String
  program_id     String
  amount         Int
  seller_amount  Int         @default(0)
  point_amount   Int         @default(0)
  payment_method String      @default("card")
  status         OrderStatus @default(pending)
  payment_id     String      @unique
  scheduled_at     DateTime?
  message          String?
  coupon_discount  Int         @default(0)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  buyer         User                 @relation(fields: [buyer_id], references: [id])
  program       Program              @relation(fields: [program_id], references: [id])
  payment       Payment?
  review        Review?
  settlement    Settlement?
  permissions   DownloadPermission[]
  coupon_usage  CouponUsage?

  @@map("orders")
}

model Payment {
  id            String    @id @default(uuid())
  order_id      String    @unique
  pg_provider   String
  pg_tid        String
  imp_uid       String    @unique
  paid_amount   Int
  paid_at       DateTime
  receipt_url   String?
  refunded_at   DateTime?
  refund_amount Int?
  raw_response  Json

  order Order @relation(fields: [order_id], references: [id])

  @@map("payments")
}

model DownloadPermission {
  id                 String    @id @default(uuid())
  order_id           String
  buyer_id           String
  program_file_id    String
  granted_at         DateTime  @default(now())
  download_count     Int       @default(0)
  max_downloads      Int       @default(5)
  last_downloaded_at DateTime?
  is_revoked         Boolean   @default(false)

  order        Order          @relation(fields: [order_id], references: [id])
  buyer        User           @relation(fields: [buyer_id], references: [id])
  program_file ProgramFile    @relation(fields: [program_file_id], references: [id])
  url_logs     SignedUrlLog[]

  @@unique([order_id, program_file_id])
  @@map("download_permissions")
}

model SignedUrlLog {
  id               String   @id @default(uuid())
  permission_id    String
  signed_url_token String   @unique
  expires_at       DateTime
  is_used          Boolean  @default(false)
  ip_address       String?
  user_agent       String?
  created_at       DateTime @default(now())

  permission DownloadPermission @relation(fields: [permission_id], references: [id])

  @@map("signed_url_logs")
}

model Settlement {
  id           String           @id @default(uuid())
  seller_id    String
  order_id     String           @unique
  gross_amount Int
  fee_rate     Decimal          @default(0.1) @db.Decimal(5, 4)
  fee_amount   Int
  net_amount   Int
  status       SettlementStatus @default(pending)
  scheduled_at DateTime
  settled_at   DateTime?
  bank_name    String?
  bank_account String?

  seller User  @relation(fields: [seller_id], references: [id])
  order  Order @relation(fields: [order_id], references: [id])

  @@map("settlements")
}

model Review {
  id            String   @id @default(uuid())
  order_id      String   @unique
  buyer_id      String
  program_id    String
  rating        Int
  content       String   @db.Text
  photo_urls    String[]
  is_visible    Boolean  @default(true)
  helpful_count Int      @default(0)
  created_at    DateTime @default(now())

  order   Order   @relation(fields: [order_id], references: [id])
  buyer   User    @relation(fields: [buyer_id], references: [id])
  program Program @relation(fields: [program_id], references: [id])

  @@map("reviews")
}

model PointTransaction {
  id           String               @id @default(uuid())
  user_id      String
  amount       Int
  type         PointTransactionType
  description  String
  reference_id String?
  created_at   DateTime             @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("point_transactions")
}

model Withdrawal {
  id             String           @id @default(uuid())
  seller_id      String
  amount         Int
  bank_name      String
  account_number String
  account_holder String
  status         WithdrawalStatus @default(pending)
  admin_note     String?
  requested_at   DateTime         @default(now())
  processed_at   DateTime?

  seller User @relation(fields: [seller_id], references: [id])

  @@map("withdrawals")
}

model Notice {
  id         String   @id @default(uuid())
  category   String
  title      String
  content    String   @db.Text
  image_url  String?
  is_new     Boolean  @default(false)
  is_pinned  Boolean  @default(false)
  author_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author User @relation(fields: [author_id], references: [id])

  @@map("notices")
}

model UserCoupon {
  id            String   @id @default(uuid())
  user_id       String
  coupon_id     String
  registered_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)

  @@unique([user_id, coupon_id])
  @@map("user_coupons")
}

model Coupon {
  id             String      @id @default(uuid())
  code           String      @unique
  type           CouponType
  discount_value Int
  scope          CouponScope
  seller_id      String?
  program_id     String?
  min_price      Int         @default(0)
  max_discount   Int?
  usage_limit    Int?
  per_user_limit Int         @default(1)
  used_count     Int         @default(0)
  is_active      Boolean     @default(true)
  expires_at     DateTime?
  created_by     String
  description    String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  creator      User          @relation("CouponCreator", fields: [created_by], references: [id])
  program      Program?      @relation(fields: [program_id], references: [id])
  usages       CouponUsage[]
  user_coupons UserCoupon[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  coupon_id String
  user_id   String
  order_id  String   @unique
  discount  Int
  used_at   DateTime @default(now())

  coupon Coupon @relation(fields: [coupon_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])
  order  Order  @relation(fields: [order_id], references: [id])

  @@map("coupon_usages")
}

model Wishlist {
  id         String   @id @default(uuid())
  user_id    String
  program_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program Program @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([user_id, program_id])
  @@map("wishlists")
}

model CartItem {
  id         String   @id @default(uuid())
  user_id    String
  program_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program Program @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([user_id, program_id])
  @@map("cart_items")
}

model Inquiry {
  id          String        @id @default(uuid())
  user_id     String
  program_id  String?
  target_type InquiryTarget
  title       String
  content     String        @db.Text
  status      InquiryStatus @default(open)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  user    User          @relation(fields: [user_id], references: [id])
  program Program?      @relation(fields: [program_id], references: [id])
  replies InquiryReply[]

  @@map("inquiries")
}

model InquiryReply {
  id         String   @id @default(uuid())
  inquiry_id String
  author_id  String
  content    String   @db.Text
  created_at DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [author_id], references: [id])

  @@map("inquiry_replies")
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  type       NotificationType
  title      String
  body       String
  link       String?
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Report {
  id          String       @id @default(uuid())
  reporter_id String
  program_id  String
  reason      ReportReason
  detail      String?      @db.Text
  status      ReportStatus @default(pending)
  admin_note  String?
  reviewer_id String?
  created_at  DateTime     @default(now())
  reviewed_at DateTime?

  reporter User    @relation("ReportReporter", fields: [reporter_id], references: [id])
  reviewer User?   @relation("ReportReviewer", fields: [reviewer_id], references: [id])
  program  Program @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@map("reports")
}

model DepositRequest {
  id           String        @id @default(uuid())
  user_id      String
  amount       Int
  status       DepositStatus @default(pending)
  admin_note   String?
  requested_at DateTime      @default(now())
  processed_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@map("deposit_requests")
}

model AdminSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("admin_settings")
}

model ChatRoom {
  id         String       @id @default(uuid())
  type       ChatRoomType
  user_id    String
  seller_id  String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  user     User          @relation("ChatRoomUser", fields: [user_id], references: [id])
  seller   User?         @relation("ChatRoomSeller", fields: [seller_id], references: [id])
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(uuid())
  room_id    String
  sender_id  String
  content    String   @db.Text
  image_url  String?
  file_url   String?
  file_name  String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  room   ChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessageSender", fields: [sender_id], references: [id])

  @@map("chat_messages")
}

model ChatTyping {
  room_id  String
  user_id  String
  typed_at DateTime

  @@id([room_id, user_id])
  @@map("chat_typing")
}

model GiftCardUsage {
  id       String   @id @default(uuid())
  pin      String   @unique
  user_id  String
  amount   Int
  provider String
  used_at  DateTime @default(now())

  @@map("gift_card_usages")
}

enum ProductType {
  file_product
  class
}

enum PointTransactionType {
  charge_card
  charge_gift_card
  charge_bank
  charge_admin
  purchase
  purchase_reward
  refund
}

enum DepositStatus {
  pending
  completed
  rejected
}

enum UserRole {
  buyer
  seller
  manager
  admin
}

enum ProgramStatus {
  draft
  active
  paused
  deleted
}

enum OrderStatus {
  pending
  paid
  confirmed
  refunded
  cancelled
}

enum SettlementStatus {
  pending
  scheduled
  completed
  held
}

enum WithdrawalStatus {
  pending
  processing
  completed
  rejected
}

enum CouponType {
  percentage
  fixed
}

enum ReportReason {
  inappropriate_content
  spam
  copyright
  fake
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

enum CouponScope {
  global
  seller
  program
}

enum InquiryTarget {
  seller
  admin
}

enum InquiryStatus {
  open
  answered
  closed
}

enum NotificationType {
  order_paid
  order_confirmed
  order_refunded
  withdrawal_processed
  inquiry_answered
  chat_message
}

enum ChatRoomType {
  seller
  admin
}
